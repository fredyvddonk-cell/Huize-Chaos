{
  "name": "Huize Chaos",
  "short_name": "Huize Chaos",
  "description": "Een beetje orde in de chaos.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5F1FA",
  "theme_color": "#957AC1",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
          ]
        }
      ]
    }
  }
}
